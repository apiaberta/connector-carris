PORT=3017
MONGO_URI=mongodb://localhost:27017/apiaberta-carris

# Vehicle poll interval in ms. Clamped to 60000–120000. Default 90000.
VEHICLES_POLL_MS=90000

# Mongo persist for live positions: changed (default) | all | off
# changed = bulkWrite only new/moved vehicles on the unique {id:1} key
# off     = in-memory Map only (no vehicle writes)
VEHICLES_PERSIST=changed

# Bounded in-memory snapshot of live positions (source of truth for GET)
VEHICLES_SNAPSHOT_MAX=4000
VEHICLES_SNAPSHOT_TTL_MS=600000
